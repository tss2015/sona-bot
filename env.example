# Miss Sona v3.0 — The Secret Squad | Environment Configuration
# Copy: cp .env.example .env  → then edit
# ── Required ──────────────────────────────────────
BOT_TOKEN=1234567890:AAH_YourBotTokenFromAtBotFatherHere

# ── Optional ──────────────────────────────────────
# Telegram user ID of bot OWNER (for /addbword vault + owner bypass)
# Get via @userinfobot or /id in Telegram
OWNER_ID=123456789

# SQLite path (default: miss_sona.db)
DB_PATH=miss_sona.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Support Group Logging (NEW v3.0) ──────────────
# Private log group where EVERY admin action is logged
# 1. Create private group, add bot as admin
# 2. Send /id in that group to get its ID (e.g. -1001234567890)
# 3. Paste below
SUPPORT_CHAT_ID=-1001234567890
# Alias also accepted: LOG_CHANNEL_ID
SUPPORT_LINK=https://t.me/SecretSquadSupport

# Branding (shown in every /start and log)
BRAND_NAME=The Secret Squad

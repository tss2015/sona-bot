# Miss Sona configuration - copy to .env next to bot.py
BOT_TOKEN=123456789:AAReplaceWithYourBotFatherToken
OWNER_IDS=123456789
DB_PATH=bot_data.db

# Moderation
WARN_LIMIT=3
CONTENT_BAN_THRESHOLD=2
BANNED_WORDS=use here

# Link policy
ALLOWED_DOMAINS=github.com,stackoverflow.com
LINK_WHITELIST=

# Captcha
CAPTCHA_TIMEOUT=120

# Broadcasts
BROADCAST_COOLDOWN=300
MENTION_DELAY=3
MENTION_BATCH_SIZE=1
MAX_MENTIONS=40
ACTIVE_WINDOW_DAYS=30

# Game
MAX_GUESSES=30
WORDS_FILE=

# OCR
OCR_LANG=eng
OCR_MAX_BYTES=8388608
TESSERACT_CMD=

# Diagnostics
ERROR_CHAT_ID=
LOG_LEVEL=INFO

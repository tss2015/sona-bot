# Miss Sona — Environment Configuration
# Copy this file to .env and fill your values:  cp .env.example .env

# ── Required ──────────────────────────────────────
BOT_TOKEN=1234567890:AAH_YourBotTokenFromAtBotFatherHere

# ── Optional ──────────────────────────────────────
# Telegram user ID of the bot OWNER (for global vault /addbword etc.)
# Get via @userinfobot or /id command
OWNER_ID=123456789

# Custom SQLite path (default: miss_sona.db in project root)
DB_PATH=miss_sona.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
